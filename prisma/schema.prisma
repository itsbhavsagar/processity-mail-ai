generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (e.g. darwin-arm64). The two Debian/OpenSSL-3.0
  // targets cover both Oracle Cloud shapes on node:22-bookworm-slim — x86-64
  // Flex and Ampere (arm64) — so the query engine loads no matter which host
  // (or CI arch) builds the image.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GmailSync {
  email           String    @id
  googleSub       String    @unique
  refreshTokenEnc String
  historyId       String?
  watchExpiration DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gmail_sync")
}
